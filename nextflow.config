/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    purkinje_cell_segmentation Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Input: glob of H&E TIFFs, one sample per file (sample id = file name without extension)
    images = '/gpfs/bwfor/work/ws/hd_qg295-VisiumHD_images/*tif'
    outdir = 'results'

    // Model: downloaded from Hugging Face (see scripts/hf_config.py) unless --model is set to a
    // local checkpoint, in which case DOWNLOAD_MODEL is skipped.
    hf_repo_id  = 'sebgoti/purkinje_cellposesam'
    hf_filename = 'cp4_20260907_102211'  // null = first non-README file in the repo
    model       = null

    // GPU image (sopa 2.2.9, cellpose 4.2.1.1, spatialdata 0.8.0,
    // torch 2.6.0+cu124), used for every step so the Zarr format always matches between writer
    // and reader. 
    container_sopa_cellpose = 'docker://ghcr.io/sebgoti/sopa-cellpose-gpu:v1'

    // SOPA / Cellpose options -- see scripts/sopa_segment_he.py --help for details
    tile_width         = 4096
    tile_overlap       = 256
    diameter           = 0.0     // 0 = no rescaling (the model was trained on raw 20x crops)
    min_area           = 50.0
    flow_threshold     = 0.4
    cellprob_threshold = 0.0
    gaussian_sigma     = 0.0
    clip_limit         = 0.0
    skip_tissue_roi    = false
    tissue_blur_kernel_size  = 5
    tissue_open_kernel_size  = 5
    tissue_close_kernel_size = 5
    tissue_drop_threshold    = 0.01
    gpu                = true
    sopa_backend       = 'none'  // sequential tiles; 'dask'/'threadpool' can hit CUDA context errors

    // Merging with externally produced nuclei masks (step skipped unless nuclei_masks is set).
    // nuclei_masks is a glob, e.g. '/path/to/nuclei/*_nuclei_mask.tif'; each file is matched to
    // its image by stripping nuclei_mask_suffix (and .tif/.tiff) from the file name. The Purkinje
    // mask always wins: a nucleus with more than merge_max_overlap of its area inside Purkinje
    // cells is dropped, otherwise it is kept outside them. See scripts/merge_masks.py.
    nuclei_masks        = null
    nuclei_mask_suffix  = '_nuclei_mask'
    merge_max_overlap   = 0.5

    // Publishing
    publish_dir_mode = 'copy'
    publish_zarr     = true      // the Zarr stores are roughly the size of the input TIFFs

    // SLURM account passed to every job Nextflow submits (null = cluster default)
    slurm_account = 'bw22b001'
}

process {
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel:process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // Streams the TIFF chunk-by-chunk, so RAM stays proportional to a few 4096x4096 chunks per
    // worker thread rather than the whole slide.
    withLabel:process_zarr {
        cpus   = { 8     * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // Reads both masks in 1024-row bands: ~0.5 GB per band for the widest slide, plus
    // per-nucleus counters.
    withLabel:process_merge {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withName:DOWNLOAD_MODEL {
        publishDir = [ path: { "${params.outdir}/model" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn == 'versions.yml' ? null : fn.tokenize('/')[-1] } ]
    }
    withName:SOPA_WRITE_ZARR {
        publishDir = [ path: { "${params.outdir}/zarr" }, mode: params.publish_dir_mode,
                       enabled: params.publish_zarr,
                       saveAs: { fn -> fn == 'versions.yml' ? null : fn } ]
    }
    withName:MERGE_MASKS {
        publishDir = [ path: { "${params.outdir}/merged_masks" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn == 'versions.yml' ? null : fn } ]
    }
    // Resources set by name, not by the process_gpu label: the profiles below also configure
    // withLabel:process_gpu, and a profile's block replaces a same-selector base block wholesale.
    // Kept small so the job fits in gaps on the busy GPU nodes (reference: an interactive
    // `salloc --gres=gpu:1 --mem=16GB` gets scheduled). Tiles are segmented one at a time and
    // the mask TIFF is written tile by tile, so memory doesn't grow with slide size; an
    // out-of-memory kill (exit 137) is retried with 32 GB, then 48 GB.
    withName:SOPA_SEGMENT {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 3.h  * task.attempt }
        publishDir = [ path: { "${params.outdir}/masks" }, mode: params.publish_dir_mode,
                       saveAs: { fn -> fn == 'versions.yml' ? null : fn } ]
    }
}

profiles {
    // bwForCluster Helix: CPU steps on cpu-single, segmentation on gpu-single
    helix {
        process {
            executor = 'slurm'
            queue    = 'cpu-single'
            clusterOptions = { params.slurm_account ? "--account=${params.slurm_account}" : '' }
            withLabel:process_gpu {
                queue          = 'gpu-single'
                clusterOptions = { "--gres=gpu:1" + (params.slurm_account ? " --account=${params.slurm_account}" : '') }
                accelerator    = 1
            }
        }
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '60m'
        // Share the image cache with tspc so the 5 GB sopa-cellpose image isn't pulled again
        singularity.cacheDir    = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: '/gpfs/bwfor/work/ws/hd_dy329-tspc2/singularity_images'
        process {
            withLabel:process_gpu { containerOptions = '--nv' }
        }
    }
    apptainer {
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.pullTimeout = '60m'
        apptainer.cacheDir    = System.getenv('NXF_APPTAINER_CACHEDIR') ?: '/gpfs/bwfor/work/ws/hd_dy329-tspc2/singularity_images'
        process {
            withLabel:process_gpu { containerOptions = '--nv' }
        }
    }
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            withLabel:process_gpu { containerOptions = '--gpus all' }
        }
    }
    // Quick end-to-end check on the smallest slide only
    test {
        params.images = '/gpfs/bwfor/work/ws/hd_qg295-VisiumHD_images/260506_CO65_CLB1_VisiumHD_20X_slide8.tif'
        params.outdir = 'results_test'
    }
}

env {
    PYTHONNOUSERSITE = 1
}

process.shell = ['bash', '-C', '-e', '-u', '-o', 'pipefail']

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_timestamp}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_timestamp}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_timestamp}.txt" }

manifest {
    name            = 'tanevskilab/purkinje_cell_segmentation'
    description     = 'CellposeSAM + SOPA segmentation of Purkinje cells in 20x H&E whole-slide images'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
}
